# MemChat backend settings. Copy to .env and fill in what you need.
# A blank value means the default shown in its comment. Only GROQ_API_KEY is
# required to run locally; see the README for what production needs.

# ---------- Groq ----------
# Required. API key for chat and transcription (https://console.groq.com/keys).
GROQ_API_KEY=
# Groq's OpenAI-compatible endpoint. Default: https://api.groq.com/openai/v1
GROQ_BASE_URL=
# Chat model; must support tool calling. Default: openai/gpt-oss-120b
GROQ_CHAT_MODEL=
# Speech-to-text model for audio notes and voice input. Default: whisper-large-v3
GROQ_TRANSCRIBE_MODEL=

# ---------- Qdrant ----------
# Full URL including the port. Default: http://localhost:6333 (local Docker). Production: your Qdrant Cloud cluster URL with :6333.
QDRANT_URL=
# Qdrant Cloud API key. Default: none (local Qdrant needs no key). Production: required.
QDRANT_API_KEY=
# Collection holding the notes, created automatically. Default: notes
NOTES_COLLECTION=

# ---------- Embeddings (fastembed, runs inside the backend) ----------
# fastembed model name. Default: BAAI/bge-small-en-v1.5
EMBED_MODEL=
# Vector size; must match the model. Default: 384
EMBED_DIMS=
# Where the model is cached after its first download. Default: backend/.model_cache
EMBED_CACHE_DIR=

# ---------- Audio notes ----------
# true or false. Default: on, except on Render (RENDER=true), whose disk is wiped on restart.
AUDIO_NOTES_ENABLED=
# Folder for recordings. Default: backend/audio_files
AUDIO_DIR=
# Largest recording accepted, in MB (Groq's Whisper limit is 25). Default: 25
AUDIO_MAX_MB=
# Signs short-lived audio links; any long random string. Default: a new one each start, so old links stop working.
AUDIO_TOKEN_SECRET=
# How long an audio link works, in seconds. Default: 900
AUDIO_TOKEN_TTL_SECONDS=

# ---------- Behaviour ----------
# Days a deleted note stays in the trash before it is removed for good. Default: 30
TRASH_RETENTION_DAYS=
# Results for the search box in the notes view. Default: 8
SEARCH_LIMIT=
# Most tool calls the assistant may chain in one reply. Default: 6
CHAT_MAX_TOOL_ROUNDS=
# Most recent chat messages sent to the model. Default: 40
CHAT_HISTORY_MESSAGES=
# gpt-oss reasoning effort: low, medium or high; reasoning tokens count against Groq's rate limit. Default: low
CHAT_REASONING_EFFORT=
# Notes the assistant sees per search. Default: 5
CHAT_SEARCH_LIMIT=

# ---------- CORS ----------
# Browser origins allowed to call the API, comma separated, no trailing slash. Default: http://localhost:5173. Production: the Vercel URL.
ALLOWED_ORIGINS=
