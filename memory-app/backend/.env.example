# ---------- Groq (required) ----------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# ---------- Qdrant ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
NOTES_COLLECTION=notes

# ---------- Embeddings (fastembed, runs locally) ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMS=384
# Where the model is cached after its first download. Defaults to backend/.model_cache
# EMBED_CACHE_DIR=

# ---------- Audio notes ----------
# Local folder for recordings. Replace with object storage before deploying:
# Render's disk is wiped on every deploy and restart.
# AUDIO_DIR=
AUDIO_MAX_MB=25
# Signs the short-lived audio URLs. Any long random string. If empty, a new one
# is made at each start and older audio links stop working.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIO_TOKEN_SECRET=
AUDIO_TOKEN_TTL_SECONDS=900

# ---------- Behaviour ----------
TRASH_RETENTION_DAYS=30
SEARCH_LIMIT=8
CHAT_MAX_TOOL_ROUNDS=6
CHAT_HISTORY_MESSAGES=40
# gpt-oss reasoning effort: low, medium or high. Reasoning tokens count against
# Groq's per-minute token limit.
CHAT_REASONING_EFFORT=low
CHAT_SEARCH_LIMIT=5
